{
  "title": "Middleware in ASP.NET Core",
  "duration": "30m",
  "cards": [
    {
      "id": "middleware-intro",
      "title": "What is Middleware?",
      "type": "content",
      "duration": "5m",
      "content": "<p>Middleware is software assembled into an app pipeline to handle requests and responses.</p>\n<p>Each component chooses whether to pass the request to the next component in the pipeline and can perform work before and after the next component is invoked.</p>"
    },
    {
      "id": "middleware-pipeline-mcq",
      "title": "Pipeline Execution",
      "type": "mcq",
      "duration": "3m",
      "content": {
        "options": [
          {
            "id": "a",
            "text": "Middleware executes strictly in parallel."
          },
          {
            "id": "b",
            "text": "Middleware executes in a sequential pipeline order for requests and in reverse for responses."
          },
          {
            "id": "c",
            "text": "Middleware only executes after the controller finishes."
          }
        ],
        "correctId": "b"
      }
    },
    {
