            "text": "Maven"
          },
          {
            "id": "d",
            "text": "Gradle"
          }
        ],
        "correctId": "b"
      }
    },
    {
      "id": "project-creation-order",
      "title": "Steps to Initialize a Vue 3 Project",
      "type": "order",
      "duration": "3m",
      "content": {
        "items": [
          {
            "id": "1",
            "text": "Run the scaffolding command (npm create vue@latest)"
          },
          {
            "id": "2",
            "text": "Select project name and optional features (TypeScript, Router, Pinia)"
          },
          {
            "id": "3",
            "text": "Navigate into the newly created project directory"
          },
          {
            "id": "4",
            "text": "Install dependencies using npm install"
          },
          {
            "id": "5",
            "text": "Start the development server using npm run dev"
          }
        ],
        "correctOrder": [
          "1",
          "2",
          "3",
          "4",
          "5"
        ]
      }
